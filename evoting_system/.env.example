# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=evoting_dev
DB_USER=evoting_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Only used by auditlog/tests.py::test_fr_db01_auditlog_insert_only_at_role_level
# (FR-DB-01) -- NOT read by Django itself. See SETUP.md step 6 for how
# to create this role via scripts/setup_db_roles.sql. Leave unset to
# skip that one test locally.
DB_APP_USER=evoting_app
DB_APP_PASSWORD=change-me
