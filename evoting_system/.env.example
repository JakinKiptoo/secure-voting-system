# Copy to .env and fill in real values. Never commit the real .env file.

DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=evoting_dev
DB_USER=evoting_user
DB_PASSWORD=CHANGE_ME
DB_HOST=localhost
DB_PORT=5432

# Restricted runtime role. NOT read by Django itself. Used by the two
# role-level tests in auditlog/tests.py (FR-DB-01, FR-SES-04) and passed to
# scripts/setup_db_roles.sql as psql -v app_password=... (SETUP.md step 6).
# Leave DB_APP_PASSWORD unset to skip those two tests locally.
DB_APP_USER=evoting_app
DB_APP_PASSWORD=CHANGE_ME
